---
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import SEO from '~/components/layout/SEO.astro';
import Schema from '~/components/layout/Schema.astro';
import CookieConsent from '~/components/common/CookieConsent.astro';
import '../styles/global.css';
import StarField from '~/components/common/StarField.astro'

interface Props {
	siteTitle?: string;
	description?: string;
    image?: string;
    article?: boolean;
    noindex?: boolean;
    nofollow?: boolean;
    availableLangs?: string[];
    children?: any;
}

import { siteConfig, ACTION_LINKS } from '~/site.config';


import { defaultLang } from '~/i18n/ui';
import { isRtl, useTranslations } from '~/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
const brandName = (t as any)['brand.name'] || siteConfig.name;

const { 
    siteTitle = (t as any)['site.title'] || 'Portfolio',
    description = siteConfig.description, 
    image, 
    article = false,
    noindex = false,
    nofollow = false,
    availableLangs
} = Astro.props;

const title = `${siteTitle} | ${brandName}`;
const dir = isRtl(lang) ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
        <SEO 
            title={title} 
            description={description} 
            image={image} 
            article={article} 
            noindex={noindex}
            nofollow={nofollow}
            availableLangs={availableLangs}
        />
        <Schema item={{
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": brandName,
            "url": Astro.site,
            "logo": new URL(siteConfig.logo.srcDark, Astro.site).toString(),
            "sameAs": [
                ACTION_LINKS.social?.github,
                ACTION_LINKS.social?.linkedin,
            ].filter(Boolean)
        }} />
        <Schema item={{
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Daniel Pastor Soler",
            "url": Astro.site,
            "jobTitle": "Freelance Sysadmin, DevOps Engineer & IT Security Consultant",
            "worksFor": {
                "@type": "Organization",
                "name": "dpastor.eu"
            },
            "address": {
                "@type": "PostalAddress",
                "addressCountry": "ES",
                "addressRegion": "Comunitat Valenciana"
            },
            "knowsAbout": ["Linux", "Kubernetes", "DevOps", "Sysadmin", "Cybersecurity", "Docker", "Ansible", "Terraform", "Wazuh", "Grafana", "Infrastructure as Code"],
            "sameAs": [
                ACTION_LINKS.social?.github,
                ACTION_LINKS.social?.linkedin,
            ].filter(Boolean)
        }} />
         {Astro.url.pathname !== '/' && (
            <Schema item={{
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": Astro.url.pathname.split('/').filter(Boolean).map((part, index, arr) => ({
                    "@type": "ListItem",
                    "position": index + 1,
                    "name": part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
                    "item": new URL(arr.slice(0, index + 1).join('/'), Astro.site).toString()
                }))
            }} />
        )}

        <!-- Google Fonts: Syne (headings) + DM Sans (body) + JetBrains Mono (code) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

        <!-- Theme: dark by default, respects localStorage and system preference -->
        <script is:inline>
            (function() {
                const stored = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                // Dark by default unless user explicitly chose light
                const isDark = stored ? stored === 'dark' : (prefersDark !== false);
                if (isDark) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
        </script>

        <slot name="head" />
        <!-- Language detection: redirect to browser preferred language on first visit -->
        <script is:inline>
            (function() {
                const path = window.location.pathname;
                // Solo en la raíz de idioma (homepage de es o en)
                if (path !== '/es/' && path !== '/en/') return;

                // Si el usuario ya eligió idioma manualmente, respetarlo siempre
                const stored = localStorage.getItem('lang');
                if (stored) {
                    if (path !== '/' + stored + '/') {
                        window.location.replace('/' + stored + '/');
                    }
                    return;
                }

                // Primera visita: detectar idioma del navegador
                const browserLang = (navigator.language || 'es').toLowerCase();
                const prefersSpanish = browserLang.startsWith('es');
                const targetLang = prefersSpanish ? 'es' : 'en';
                const targetPath = '/' + targetLang + '/';

                // Guardar preferencia para visitas futuras
                localStorage.setItem('lang', targetLang);

                // Redirigir solo si es necesario (evita loop)
                if (path !== targetPath) {
                    window.location.replace(targetPath);
                }
            })();
        </script>

		</head>
		<body class="min-h-dvh flex flex-col antialiased bg-background text-foreground">
        <!-- Ambient glow layer -->
        <div class="page-glow" aria-hidden="true"></div>

        <!-- Star field canvas -->
        <StarField />

        <div class="fixed top-0 w-full z-50 flex flex-col items-stretch">
            <Header availableLangs={availableLangs} />
        </div>
		<main data-pagefind-ignore>
			<slot />
		</main>
        <CookieConsent />
		<Footer />

	</body>
</html>