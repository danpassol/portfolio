---
// StarField.astro
// Canvas global fijo con partículas conectadas (constelaciones) + parallax de ratón
// Uso: <StarField /> en el layout, sustituye al canvas inline anterior
---

<canvas id="star-canvas" aria-hidden="true"></canvas>

<script is:inline>
(function () {
  const canvas = document.getElementById('star-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  // ── Config ──────────────────────────────────────────────────────────
  const CONFIG = {
    count: 120,
    maxDist: 140,
    mouseRadius: 120,
    mouseForce: 60,
    speed: 0.3,
    particleColor: [210, 230, 255],
    lineColor: [150, 180, 255],
  };

  let W, H, dpr;
  let particles = [];
  let mouse = { x: -9999, y: -9999 };
  let animId;
  let primaryRGB = [150, 180, 255]; // fallback, se sobreescribe al leer CSS

  // ── Leer --color-primary del DOM y convertir a RGB ───────────────────
  function readPrimaryColor() {
    const raw = getComputedStyle(document.documentElement)
      .getPropertyValue('--color-primary').trim();
    if (!raw) return;

    // Formato posible: #rrggbb, rgb(...), hsl(...)
    const tmp = document.createElement('div');
    tmp.style.color = raw;
    document.body.appendChild(tmp);
    const computed = getComputedStyle(tmp).color; // siempre devuelve rgb(...)
    document.body.removeChild(tmp);

    const m = computed.match(/(\d+),\s*(\d+),\s*(\d+)/);
    if (m) primaryRGB = [parseInt(m[1]), parseInt(m[2]), parseInt(m[3])];
  }

  // ── Resize ──────────────────────────────────────────────────────────
  function resize() {
    dpr = window.devicePixelRatio || 1;
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);
  }

  // ── Partículas ───────────────────────────────────────────────────────
  function createParticles() {
    particles = [];
    for (let i = 0; i < CONFIG.count; i++) {
      const angle = Math.random() * Math.PI * 2;
      const spd   = CONFIG.speed * (0.3 + Math.random() * 0.7);
      particles.push({
        x:  Math.random() * W,
        y:  Math.random() * H,
        ox: 0, oy: 0,
        vx: Math.cos(angle) * spd,
        vy: Math.sin(angle) * spd,
        r:  0.8 + Math.random() * 1.6,
        alpha: 0.4 + Math.random() * 0.6,
        twinkleOffset: Math.random() * Math.PI * 2,
        twinkleSpeed:  0.4 + Math.random() * 0.8,
        heat: 0, // 0 = color base, 1 = --color-primary
      });
    }
  }

  // ── Interpolar entre dos colores RGB ────────────────────────────────
  function lerpColor(a, b, t) {
    return [
      Math.round(a[0] + (b[0] - a[0]) * t),
      Math.round(a[1] + (b[1] - a[1]) * t),
      Math.round(a[2] + (b[2] - a[2]) * t),
    ];
  }

  // ── Update ───────────────────────────────────────────────────────────
  function update(t) {
    const ts = t * 0.001;
    particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;

      if (p.x < -20) p.x = W + 20;
      if (p.x > W + 20) p.x = -20;
      if (p.y < -20) p.y = H + 20;
      if (p.y > H + 20) p.y = -20;

      const dx = p.x - mouse.x;
      const dy = p.y - mouse.y;
      const dist = Math.sqrt(dx * dx + dy * dy);

      let targetOx = 0, targetOy = 0;
      let targetHeat = 0;

      if (dist < CONFIG.mouseRadius && dist > 0) {
        const t01 = 1 - dist / CONFIG.mouseRadius;
        const force = t01 * CONFIG.mouseForce;
        targetOx = (dx / dist) * force;
        targetOy = (dy / dist) * force;
        targetHeat = t01; // más cerca = más color primario
      }

      p.ox   += (targetOx   - p.ox)   * 0.08;
      p.oy   += (targetOy   - p.oy)   * 0.08;
      p.heat += (targetHeat - p.heat) * 0.08;

      p.currentAlpha = p.alpha * (0.65 + 0.35 * Math.sin(ts * p.twinkleSpeed + p.twinkleOffset));
    });
  }

  // ── Draw ─────────────────────────────────────────────────────────────
  function draw() {
    ctx.clearRect(0, 0, W, H);

    const base = CONFIG.particleColor;
    const lineBase = CONFIG.lineColor;

    // Líneas
    for (let i = 0; i < particles.length; i++) {
      const a = particles[i];
      const ax = a.x + a.ox;
      const ay = a.y + a.oy;
      for (let j = i + 1; j < particles.length; j++) {
        const b = particles[j];
        const bx = b.x + b.ox;
        const by = b.y + b.oy;
        const dx = ax - bx;
        const dy = ay - by;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONFIG.maxDist) {
          const proximity = 1 - dist / CONFIG.maxDist;
          const opacity = proximity * 0.35 * Math.min(a.currentAlpha, b.currentAlpha);
          const heat = Math.max(a.heat, b.heat);
          const [lr, lg, lb] = lerpColor(lineBase, primaryRGB, heat);
          ctx.beginPath();
          ctx.moveTo(ax, ay);
          ctx.lineTo(bx, by);
          ctx.strokeStyle = `rgba(${lr},${lg},${lb},${opacity + heat * 0.25})`;
          ctx.lineWidth = 0.6 + heat * 0.8;
          ctx.stroke();
        }
      }
    }

    // Partículas
    particles.forEach(p => {
      const px = p.x + p.ox;
      const py = p.y + p.oy;
      const alpha = p.currentAlpha;
      const [pr, pg, pb] = lerpColor(base, primaryRGB, p.heat);

      if (p.r > 1.5 || p.heat > 0.1) {
        const glowR = p.r * (4 + p.heat * 4);
        const g = ctx.createRadialGradient(px, py, 0, px, py, glowR);
        g.addColorStop(0, `rgba(${pr},${pg},${pb},${(alpha * 0.25) + p.heat * 0.4})`);
        g.addColorStop(1, `rgba(${pr},${pg},${pb},0)`);
        ctx.beginPath();
        ctx.arc(px, py, glowR, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(px, py, p.r + p.heat * 1.2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${pr},${pg},${pb},${alpha})`;
      ctx.fill();
    });
  }

  // ── Loop ─────────────────────────────────────────────────────────────
  function loop(t) {
    update(t);
    draw();
    animId = requestAnimationFrame(loop);
  }

  // ── Init ─────────────────────────────────────────────────────────────
  resize();
  createParticles();
  readPrimaryColor();

  // Pausar/reanudar según tema + re-leer color primario
  function isDark() {
    return document.documentElement.classList.contains('dark');
  }

  function syncTheme() {
    readPrimaryColor();
    if (isDark()) {
      if (!animId) animId = requestAnimationFrame(loop);
    } else {
      cancelAnimationFrame(animId);
      animId = null;
      ctx.clearRect(0, 0, W, H);
    }
  }

  const observer = new MutationObserver(syncTheme);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  window.addEventListener('resize', () => {
    cancelAnimationFrame(animId);
    animId = null;
    resize();
    particles.forEach(p => {
      p.x = Math.min(p.x, W);
      p.y = Math.min(p.y, H);
    });
    if (isDark()) animId = requestAnimationFrame(loop);
  }, { passive: true });

  window.addEventListener('mousemove', e => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  }, { passive: true });

  window.addEventListener('mouseleave', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  });

  window.addEventListener('touchmove', e => {
    if (e.touches.length > 0) {
      mouse.x = e.touches[0].clientX;
      mouse.y = e.touches[0].clientY;
    }
  }, { passive: true });

  window.addEventListener('touchend', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  }, { passive: true });

  if (isDark()) animId = requestAnimationFrame(loop);

  document.addEventListener('mobile-menu-open', () => {
    document.documentElement.classList.add('menu-open');
  });
  document.addEventListener('mobile-menu-close', () => {
    document.documentElement.classList.remove('menu-open');
  });
})();
</script>